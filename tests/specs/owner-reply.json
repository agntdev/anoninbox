[
  {
    "name": "/reply without arguments shows usage",
    "steps": [
      {
        "send": { "text": "/reply" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Usage: /reply <token> <your message>" }
          }
        ]
      }
    ]
  },
  {
    "name": "/reply with token but no message shows usage",
    "steps": [
      {
        "send": { "text": "/reply 1" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Usage: /reply <token> <your message>" }
          }
        ]
      }
    ]
  },
  {
    "name": "/reply with invalid token shows error",
    "steps": [
      {
        "send": { "text": "/reply 999 Hello there" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Message not found or expired." }
          }
        ]
      }
    ]
  },
  {
    "name": "reply callback prompts for reply text",
    "steps": [
      {
        "send": { "text": "Test message for reply" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Message received anonymously." } }
        ]
      },
      {
        "send": { "callback": "reply:1" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "sendMessage", "payload": { "text": "Type your reply to the anonymous sender:" } }
        ]
      }
    ]
  },
  {
    "name": "reply cancel callback cancels the reply",
    "steps": [
      {
        "send": { "text": "Another message" },
        "expect": [
          { "method": "sendMessage", "payload": { "text": "Message received anonymously." } }
        ]
      },
      {
        "send": { "callback": "reply:2" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "sendMessage", "payload": { "text": "Type your reply to the anonymous sender:" } }
        ]
      },
      {
        "send": { "callback": "reply:cancel" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "sendMessage", "payload": { "text": "Reply cancelled." } }
        ]
      }
    ]
  }
]
